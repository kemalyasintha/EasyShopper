{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/user?username={uname}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 13322
        }
      ],
      "UpstreamPathTemplate": "/api/user/{uname}",
      "UpstreamHttpMethod": [
        "Get"
      ],
      "Key": "basicDetails",
      "FileCacheOptions": {
        "TtlSeconds": 30
      }
    },
    {
      "DownstreamPathTemplate": "/api/order/GetAllOrders?userid={uname}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 6420
        }
      ],
      "UpstreamPathTemplate": "/api/order/{uname}",
      "UpstreamHttpMethod": [
        "Get"
      ],
      "Key": "userOrders",
      "FileCacheOptions": {
        "TtlSeconds": 40
      }
    },
    {
      "DownstreamPathTemplate": "/api/product/getproduct?productid={pid}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 9559
        }
      ],
      "UpstreamPathTemplate": "/api/product/{pid}",
      "UpstreamHttpMethod": [
        "Get"
      ],
      "RateLimitOptions": {
        "ClientIdHeader": "Oc-Client",
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "EnableHeaders": true,
        "Limit": 10,
        "Period": "15s",
        "Wait": "5s",
        "StatusCode": 429,
        "QuotaMessage": "Rate limit exceeded. Retry later."
      }
    }
  ],
  "AsyncRoutes": {
    "Authenticate": false,
    "Routes": {
      "/api/product/add": {
        "Queue": "create_product",
        "CommandType": "CreateProduct"
      },
      "/api/User": {
        "CommandType": "CreateUser"
      }
    }
  },
  "Aggregates": [
    {
      "RouteKeys": [
        "basicDetails",
        "userOrders"
      ],
      "UpstreamPathTemplate": "/api/order-history/{uname}"
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:6355"
  }
}
